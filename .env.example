# Select openai, deepseek or ollama. Set the model ID for the selected provider.
ZAIKO_LLM_PROVIDER=openai
ZAIKO_LLM_MODEL=gpt-6.1-sol
# Optional: extra model IDs offered by /model, separated by commas, for example
# deepseek-flash,gpt-6.1-sol,qwen3:8b. A tagged name such as qwen3:8b uses
# Ollama, deepseek* uses DeepSeek and gpt-* uses OpenAI; write openai:<id>,
# deepseek:<id> or ollama:<id> for other names.
ZAIKO_LLM_MODELS=

# Optional: the Ollama server, default http://127.0.0.1:11434. Ollama needs no key.
ZAIKO_OLLAMA_URL=
# Optional: Ollama context size in tokens, default 8192. Raise it if your GPU
# has room; a model that does not fit in GPU memory runs much slower.
ZAIKO_OLLAMA_CONTEXT=

# Fill in keys locally. The selected provider's key is required, plus the key of
# any other provider listed in ZAIKO_LLM_MODELS. Ollama needs neither.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
