# Select openai or deepseek. Set the model ID for the selected provider.
ZAIKO_LLM_PROVIDER=openai
ZAIKO_LLM_MODEL=gpt-6.1-sol
# Optional: extra model IDs offered by /model, separated by commas, for example
# deepseek-flash,gpt-6.1-sol. deepseek* uses DeepSeek and gpt-* uses OpenAI;
# write openai:<id> or deepseek:<id> for other names.
ZAIKO_LLM_MODELS=

# Fill in keys locally. The selected provider's key is required, plus the key of
# any other provider listed in ZAIKO_LLM_MODELS.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
