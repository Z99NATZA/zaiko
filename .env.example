# Select openai or deepseek. Set the model ID for the selected provider.
ZAIKO_LLM_PROVIDER=openai
ZAIKO_LLM_MODEL=gpt-6.1-sol
# Optional: extra model IDs offered by /model, separated by commas.
ZAIKO_LLM_MODELS=

# Fill in keys locally. Only the selected provider's key will be required.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
